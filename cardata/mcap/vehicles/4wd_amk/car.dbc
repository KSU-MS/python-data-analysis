CM_ "can bus of KSU motorsports vehicles";
CM_ BO_ 31 "raw ADC voltage reading of module1 temp sensors, relative to the car";
CM_ BO_ 32 "raw ADC voltage reading of module2 temp sensors, relative to the car";
CM_ BO_ 33 "raw ADC voltage reading of module3 temp sensors, relative to the car";
CM_ BO_ 34 "raw ADC voltage reading of module4 temp sensors, relative to the car";
CM_ BO_ 35 "raw ADC voltage reading of module5 temp sensors, relative to the car";
CM_ BO_ 105 "Precharge related diag info";
CM_ SG_ 105 precharge_state "0 - standby, 1 - precharging, 2 - online, 3 - error";
CM_ BO_ 106 "Information on IMD and BMS shutdown circuit relays, as well as IMD diagnostic info";
CM_ SG_ 106 acu_imd_pwm_duty "duty cycle of IMD: ~5% on normal conditions";
CM_ SG_ 106 acu_imd_pwm_frequency "PWM frequency of the IMD: 10hz on normal operation";
CM_ SG_ 106 acu_bms_gpio_state "Status of the BMS ENABLE output: 1 is OK, 0 is FAULTED";
CM_ SG_ 106 acu_imd_gpio_state "Status of the IMD OKHS output: 1 is OK, 0 is FAULTED";
CM_ SG_ 106 acu_bms_relay_state "Status of the BMS relay as sensed by the ACU: 1 is closed, 0 is open";
CM_ SG_ 106 acu_imd_relay_state "Status of the IMD relay as sensed by the ACU: 1 is closed, 0 is open";
CM_ BO_ 107 "ACU voltage and current measurements";
CM_ SG_ 107 acu_3v_voltage "ACU 3v rail reading";
CM_ SG_ 107 acu_5v_voltage "ACU 5v rail reading";
CM_ SG_ 107 acu_glv_current "ACU GLV current reading from the ACU";
CM_ SG_ 107 acu_glv_voltage "ACU GLV system voltage reading";
CM_ SG_ 107 acu_sdc_current "ACU shutdown circuit current reading thru the ACU";
CM_ SG_ 107 acu_sdc_voltage "ACU GLV system voltage reading";
